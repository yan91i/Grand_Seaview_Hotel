{
  "name": "hotel-ai-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pixel AI hotel simulation - 6 LLM-driven long-stay residents",
  "scripts": {
    "dev": "concurrently -n llm,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.mjs",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "concurrently": "^9.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
